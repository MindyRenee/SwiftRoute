# SAP Runtime Configuration
# Copy this file to .env and fill in your values

# Gateway
SAP_HOST=0.0.0.0
SAP_PORT=8000
SAP_LOG_LEVEL=info

# VM Mode: "mock" for dev, "firecracker" for production
SAP_VM_MODE=mock

# Grid API (leave blank to use static demo data)
SAP_GRID_API_URL=https://api.example-grid.com/v1
SAP_GRID_API_KEY=

# Payments: "mock" for dev, "stripe" for production
SAP_PAYMENT_MODE=mock
SAP_STRIPE_SECRET_KEY=sk_test_...
SAP_STRIPE_WEBHOOK_SECRET=whsec_...
SAP_PAYOUT_THRESHOLD_USD=10.0
