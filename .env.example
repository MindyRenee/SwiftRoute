# SAP Runtime Configuration
# Copy this file to .env and fill in your values

# Gateway
SAP_HOST=0.0.0.0
SAP_PORT=8000
SAP_LOG_LEVEL=info

# VM Mode:
SAP_VM_MODE=firecracker

# Grid API:
SAP_GRID_API_URL=https://api.example-grid.com/v1
SAP_GRID_API_KEY=

# Payments:
SAP_PAYMENT_MODE=stripe
SAP_STRIPE_SECRET_KEY=sk_test_...
SAP_STRIPE_WEBHOOK_SECRET=whsec_...
SAP_PAYOUT_THRESHOLD_USD=10.0
